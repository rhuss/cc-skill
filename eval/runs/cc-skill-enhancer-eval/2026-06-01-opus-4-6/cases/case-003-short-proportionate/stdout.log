{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_vrtx_017w7wjZNjSZjGGXnoJ3bSKS","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"PreToolUse hook script for intercepting tools during headless eval.\n3\t\n4\tReads tool_handlers.yaml from the workspace. Handlers contain resolved\n5\tpatterns and runtime checks (from natural language `match` and `prompt`\n6\tin eval.yaml, resolved by eval-run at workspace setup time).\n7\t\n8\tSupports:\n9\t- Auto-answering AskUserQuestion via per-case overrides\n10\t- Blocking tools based on env var checks (e.g., production Jira)\n11\t- Filtering Bash commands by content patterns\n12\t\"\"\"\n13\t\n14\timport agent_eval._bootstrap  # noqa: F401 — auto-activate venv\n15\t\n16\timport json\n17\timport os\n18\timport re\n19\timport sys\n20\tfrom pathlib import Path\n21\t\n22\timport yaml\n23\t\n24\t\n25\tdef main():\n26\t    input_data = json.load(sys.stdin)\n27\t    tool_name = input_data.get(\"tool_name\", \"\")\n28\t    tool_input = input_data.get(\"tool_input\", {})\n29\t\n30\t    # Load handler config from workspace\n31\t    config_path = Path(\"tool_handlers.yaml\")\n32\t    if not config_path.exists():\n33\t        sys.exit(0)\n34\t\n35\t    with open(config_path) as f:\n36\t        config = yaml.safe_load(f) or {}\n37\t\n38\t    # Find matching handler\n39\t    handler = _find_handler(tool_name, tool_input, config.get(\"handlers\", []))\n40\t    if not handler:\n41\t        sys.exit(0)  # No handler — pass through\n42\t\n43\t    # --- AskUserQuestion: auto-answer ---\n44\t    if tool_name == \"AskUserQuestion\":\n45\t        _handle_ask_user(tool_input, config, handler)\n46\t        return\n47\t\n48\t    # --- Env checks: block if environment doesn't match ---\n49\t    env_checks = handler.get(\"env_checks\", {})\n50\t    if env_checks:\n51\t        for var_name, check in env_checks.items():\n52\t            value = os.environ.get(var_name, \"\")\n53\t            must_contain = check.get(\"must_contain\", [])\n54\t            if must_contain and not any(m in value.lower() for m in must_contain):\n55\t                _deny(f\"Env {var_name}='{value}' doesn't match required: {must_contain}\")\n56\t                return\n57\t        # All env checks passed — allow\n58\t        sys.exit(0)\n59\t\n60\t    # --- Default for matched tools without specific handling: block ---\n61\t    _deny(f\"Blocked by eval harness: {handler.get('match', 'matched handler')}\")\n62\t\n63\t\n64\tdef _find_handler(tool_name, tool_input, handlers):\n65\t    \"\"\"Find the first handler that matches the tool call.\n66\t\n67\t    Bash handlers REQUIRE input_filters — without them, a handler with\n68\t    \"Bash\" in patterns would silently match every Bash command and the\n69\t    default-deny in main() would block the entire skill. To prevent that\n70\t    footgun, Bash handlers without input_filters are treated as\n71\t    misconfigured: emit a stderr warning and skip (pass-through).\n72\t    Resolve them in eval-run Step 3b before relying on the handler.\n73\t    \"\"\"\n74\t    for h in handlers:\n75\t        patterns = h.get(\"patterns\", [])\n76\t        input_filters = h.get(\"input_filters\", [])\n77\t\n78\t        if tool_name == \"Bash\" and \"Bash\" in patterns:\n79\t            if not input_filters:\n80\t                print(\n81\t                    f\"tool_handlers.yaml: handler {h.get('match', '?')!r} \"\n82\t                    \"has 'Bash' in patterns but no input_filters — \"\n83\t                    \"skipping (would deny all Bash). Resolve in eval-run \"\n84\t                    \"Step 3b.\",\n85\t                    file=sys.stderr,\n86\t                )\n87\t                continue\n88\t            command = tool_input.get(\"command\", \"\")\n89\t            if any(re.search(f, command, re.IGNORECASE) for f in input_filters):\n90\t                return h\n91\t            continue  # Bash matched pattern but not filter — skip\n92\t\n93\t        # For other tools: match by pattern only\n94\t        for pattern in patterns:\n95\t            if pattern == tool_name:\n96\t                return h\n97\t            if pattern.endswith(\"*\") and tool_name.startswith(pattern[:-1]):\n98\t                return h\n99\t\n100\t    return None\n101\t\n102\t\n103\tdef _handle_ask_user(tool_input, config, handler):\n104\t    \"\"\"Auto-answer AskUserQuestion using case overrides, LLM, or first option.\n105\t\n106\t    Resolution order for each question:\n107\t    1. Exact match in case_overrides (question text → answer)\n108\t    2. LLM-based answer (haiku) using the handler prompt + case context\n109\t    3. Fallback: pick the first option or \"yes\"\n110\t    \"\"\"\n111\t    case_overrides = config.get(\"case_overrides\", {})\n112\t    hook_model = config.get(\"hook_model\")\n113\t    prompt = handler.get(\"prompt\", \"\")\n114\t    if not prompt and handler.get(\"prompt_file\"):\n115\t        try:\n116\t            prompt = Path(handler[\"prompt_file\"]).read_text()\n117\t        except OSError:\n118\t            pass\n119\t    answers = {}\n120\t    for q in tool_input.get(\"questions\", []):\n121\t        text = q.get(\"question\", \"\")\n122\t        options = q.get(\"options\", [])\n123\t\n124\t        # 1. Exact match\n125\t        answer = case_overrides.get(text)\n126\t\n127\t        # 2. LLM-based answer\n128\t        if answer is None and options:\n129\t            answer = _llm_answer(text, options, prompt, model=hook_model)\n130\t\n131\t        # 3. Fallback\n132\t        if answer is None:\n133\t            answer = options[0][\"label\"] if options else \"yes\"\n134\t\n135\t        answers[text] = answer\n136\t\n137\t    output = {\n138\t        \"hookSpecificOutput\": {\n139\t            \"hookEventName\": \"PreToolUse\",\n140\t            \"permissionDecision\": \"allow\",\n141\t            \"updatedInput\": {\n142\t                \"questions\": tool_input[\"questions\"],\n143\t                \"answers\": answers,\n144\t            },\n145\t        }\n146\t    }\n147\t    json.dump(output, sys.stdout)\n148\t\n149\t\n150\tdef _llm_answer(question, options, handler_prompt, model=None):\n151\t    \"\"\"Use an LLM to pick the best answer for a question.\n152\t\n153\t    Reads input.yaml and answers.yaml from CWD for case-specific context.\n154\t    Returns the selected option label, or None if the API call fails.\n155\t    \"\"\"\n156\t    # Load case context\n157\t    case_context = \"\"\n158\t    for fname in (\"input.yaml\", \"answers.yaml\"):\n159\t        p = Path(fname)\n160\t        if p.exists():\n161\t            try:\n162\t                case_context += f\"\\n--- {fname} ---\\n{p.read_text()}\\n\"\n163\t            except OSError:\n164\t                pass\n165\t\n166\t    option_labels = [o[\"label\"] for o in options]\n167\t    option_list = \"\\n\".join(\n168\t        f\"  {i+1}. {o['label']}: {o.get('description', '')}\"\n169\t        for i, o in enumerate(options)\n170\t    )\n171\t\n172\t    prompt = f\"\"\"You are answering a question on behalf of a user during an automated evaluation run.\n173\t\n174\tHandler instructions: {handler_prompt}\n175\t\n176\tCase context:\n177\t{case_context}\n178\t\n179\tQuestion: {question}\n180\t\n181\tAvailable options:\n182\t{option_list}\n183\t\n184\tBased on the handler instructions and case context, which option should be selected?\n185\tReply with ONLY the option label text, nothing else.\"\"\"\n186\t\n187\t    try:\n188\t        import anthropic\n189\t        client = anthropic.Anthropic(timeout=30.0)\n190\t        response = client.messages.create(\n191\t            model=model or \"claude-haiku-4-5-20251001\",\n192\t            max_tokens=256,\n193\t            temperature=0,\n194\t            messages=[{\"role\": \"user\", \"content\": prompt}],\n195\t        )\n196\t        answer = response.content[0].text.strip()\n197\t        # Verify the answer matches an option label\n198\t        if answer in option_labels:\n199\t            print(f\"LLM answered: {answer!r}\", file=sys.stderr)\n200\t            return answer\n201\t        # Try fuzzy match — LLM might have added quotes or slight variation\n202\t        answer_lower = answer.lower().strip('\"\\'')\n203\t        for label in option_labels:\n204\t            if label.lower() == answer_lower:\n205\t                print(f\"LLM answered (fuzzy): {label!r}\", file=sys.stderr)\n206\t                return label\n207\t        print(f\"LLM answer {answer!r} not in options {option_labels}\",\n208\t              file=sys.stderr)\n209\t    except Exception as e:\n210\t        print(f\"LLM answer failed: {e}\", file=sys.stderr)\n211\t\n212\t    return None\n213\t\n214\t\n215\tdef _deny(reason):\n216\t    \"\"\"Deny the tool call with a reason.\"\"\"\n217\t    output = {\n218\t        \"hookSpecificOutput\": {\n219\t            \"hookEventName\": \"PreToolUse\",\n220\t            \"permissionDecision\": \"deny\",\n221\t            \"reason\": reason,\n222\t        }\n223\t    }\n224\t    json.dump(output, sys.stdout)\n225\t\n226\t\n227\tif __name__ == \"__main__\":\n228\t    main()\n229\t"}]},"parent_tool_use_id":null,"session_id":"ca317b90-dcab-4e94-97cd-6de7e52b3cf4","uuid":"c172425b-93c9-4ccd-9962-1e68ba4d7e8b","timestamp":"2026-06-01T15:28:10.308Z","tool_use_result":{"type":"text","file":{"filePath":"/private/tmp/claude-501/agent-eval/2026-06-01-opus-4-6/cases/case-003-short-proportionate/hooks/tools.py","content":"#!/usr/bin/env python3\n\"\"\"PreToolUse hook script for intercepting tools during headless eval.\n\nReads tool_handlers.yaml from the workspace. Handlers contain resolved\npatterns and runtime checks (from natural language `match` and `prompt`\nin eval.yaml, resolved by eval-run at workspace setup time).\n\nSupports:\n- Auto-answering AskUserQuestion via per-case overrides\n- Blocking tools based on env var checks (e.g., production Jira)\n- Filtering Bash commands by content patterns\n\"\"\"\n\nimport agent_eval._bootstrap  # noqa: F401 — auto-activate venv\n\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\n\nimport yaml\n\n\ndef main():\n    input_data = json.load(sys.stdin)\n    tool_name = input_data.get(\"tool_name\", \"\")\n    tool_input = input_data.get(\"tool_input\", {})\n\n    # Load handler config from workspace\n    config_path = Path(\"tool_handlers.yaml\")\n    if not config_path.exists():\n        sys.exit(0)\n\n    with open(config_path) as f:\n        config = yaml.safe_load(f) or {}\n\n    # Find matching handler\n    handler = _find_handler(tool_name, tool_input, config.get(\"handlers\", []))\n    if not handler:\n        sys.exit(0)  # No handler — pass through\n\n    # --- AskUserQuestion: auto-answer ---\n    if tool_name == \"AskUserQuestion\":\n        _handle_ask_user(tool_input, config, handler)\n        return\n\n    # --- Env checks: block if environment doesn't match ---\n    env_checks = handler.get(\"env_checks\", {})\n    if env_checks:\n        for var_name, check in env_checks.items():\n            value = os.environ.get(var_name, \"\")\n            must_contain = check.get(\"must_contain\", [])\n            if must_contain and not any(m in value.lower() for m in must_contain):\n                _deny(f\"Env {var_name}='{value}' doesn't match required: {must_contain}\")\n                return\n        # All env checks passed — allow\n        sys.exit(0)\n\n    # --- Default for matched tools without specific handling: block ---\n    _deny(f\"Blocked by eval harness: {handler.get('match', 'matched handler')}\")\n\n\ndef _find_handler(tool_name, tool_input, handlers):\n    \"\"\"Find the first handler that matches the tool call.\n\n    Bash handlers REQUIRE input_filters — without them, a handler with\n    \"Bash\" in patterns would silently match every Bash command and the\n    default-deny in main() would block the entire skill. To prevent that\n    footgun, Bash handlers without input_filters are treated as\n    misconfigured: emit a stderr warning and skip (pass-through).\n    Resolve them in eval-run Step 3b before relying on the handler.\n    \"\"\"\n    for h in handlers:\n        patterns = h.get(\"patterns\", [])\n        input_filters = h.get(\"input_filters\", [])\n\n        if tool_name == \"Bash\" and \"Bash\" in patterns:\n            if not input_filters:\n                print(\n                    f\"tool_handlers.yaml: handler {h.get('match', '?')!r} \"\n                    \"has 'Bash' in patterns but no input_filters — \"\n                    \"skipping (would deny all Bash). Resolve in eval-run \"\n                    \"Step 3b.\",\n                    file=sys.stderr,\n                )\n                continue\n            command = tool_input.get(\"command\", \"\")\n            if any(re.search(f, command, re.IGNORECASE) for f in input_filters):\n                return h\n            continue  # Bash matched pattern but not filter — skip\n\n        # For other tools: match by pattern only\n        for pattern in patterns:\n            if pattern == tool_name:\n                return h\n            if pattern.endswith(\"*\") and tool_name.startswith(pattern[:-1]):\n                return h\n\n    return None\n\n\ndef _handle_ask_user(tool_input, config, handler):\n    \"\"\"Auto-answer AskUserQuestion using case overrides, LLM, or first option.\n\n    Resolution order for each question:\n    1. Exact match in case_overrides (question text → answer)\n    2. LLM-based answer (haiku) using the handler prompt + case context\n    3. Fallback: pick the first option or \"yes\"\n    \"\"\"\n    case_overrides = config.get(\"case_overrides\", {})\n    hook_model = config.get(\"hook_model\")\n    prompt = handler.get(\"prompt\", \"\")\n    if not prompt and handler.get(\"prompt_file\"):\n        try:\n            prompt = Path(handler[\"prompt_file\"]).read_text()\n        except OSError:\n            pass\n    answers = {}\n    for q in tool_input.get(\"questions\", []):\n        text = q.get(\"question\", \"\")\n        options = q.get(\"options\", [])\n\n        # 1. Exact match\n        answer = case_overrides.get(text)\n\n        # 2. LLM-based answer\n        if answer is None and options:\n            answer = _llm_answer(text, options, prompt, model=hook_model)\n\n        # 3. Fallback\n        if answer is None:\n            answer = options[0][\"label\"] if options else \"yes\"\n\n        answers[text] = answer\n\n    output = {\n        \"hookSpecificOutput\": {\n            \"hookEventName\": \"PreToolUse\",\n            \"permissionDecision\": \"allow\",\n            \"updatedInput\": {\n                \"questions\": tool_input[\"questions\"],\n                \"answers\": answers,\n            },\n        }\n    }\n    json.dump(output, sys.stdout)\n\n\ndef _llm_answer(question, options, handler_prompt, model=None):\n    \"\"\"Use an LLM to pick the best answer for a question.\n\n    Reads input.yaml and answers.yaml from CWD for case-specific context.\n    Returns the selected option label, or None if the API call fails.\n    \"\"\"\n    # Load case context\n    case_context = \"\"\n    for fname in (\"input.yaml\", \"answers.yaml\"):\n        p = Path(fname)\n        if p.exists():\n            try:\n                case_context += f\"\\n--- {fname} ---\\n{p.read_text()}\\n\"\n            except OSError:\n                pass\n\n    option_labels = [o[\"label\"] for o in options]\n    option_list = \"\\n\".join(\n        f\"  {i+1}. {o['label']}: {o.get('description', '')}\"\n        for i, o in enumerate(options)\n    )\n\n    prompt = f\"\"\"You are answering a question on behalf of a user during an automated evaluation run.\n\nHandler instructions: {handler_prompt}\n\nCase context:\n{case_context}\n\nQuestion: {question}\n\nAvailable options:\n{option_list}\n\nBased on the handler instructions and case context, which option should be selected?\nReply with ONLY the option label text, nothing else.\"\"\"\n\n    try:\n        import anthropic\n        client = anthropic.Anthropic(timeout=30.0)\n        response = client.messages.create(\n            model=model or \"claude-haiku-4-5-20251001\",\n            max_tokens=256,\n            temperature=0,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        answer = response.content[0].text.strip()\n        # Verify the answer matches an option label\n        if answer in option_labels:\n            print(f\"LLM answered: {answer!r}\", file=sys.stderr)\n            return answer\n        # Try fuzzy match — LLM might have added quotes or slight variation\n        answer_lower = answer.lower().strip('\"\\'')\n        for label in option_labels:\n            if label.lower() == answer_lower:\n                print(f\"LLM answered (fuzzy): {label!r}\", file=sys.stderr)\n                return label\n        print(f\"LLM answer {answer!r} not in options {option_labels}\",\n              file=sys.stderr)\n    except Exception as e:\n        print(f\"LLM answer failed: {e}\", file=sys.stderr)\n\n    return None\n\n\ndef _deny(reason):\n    \"\"\"Deny the tool call with a reason.\"\"\"\n    output = {\n        \"hookSpecificOutput\": {\n            \"hookEventName\": \"PreToolUse\",\n            \"permissionDecision\": \"deny\",\n            \"reason\": reason,\n        }\n    }\n    json.dump(output, sys.stdout)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":229,"startLine":1,"totalLines":229}}}
